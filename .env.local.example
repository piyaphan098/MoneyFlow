# Copy this file to .env.local and fill in your Supabase project values
# (Project Settings -> API in the Supabase dashboard)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key (Project Settings -> API -> service_role).
# SERVER-ONLY — used exclusively by the LINE webhook to bypass RLS.
# Never expose this to the browser / never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LINE Developers Console -> your channel -> Messaging API tab
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token

# Optional but recommended: protects /api/cron/* from being triggered by
# anyone who guesses the URL. Generate any random string and set the same
# value in Vercel's env vars — Vercel Cron sends it automatically as
# `Authorization: Bearer <value>` when this variable exists on the project.
CRON_SECRET=any-random-string-you-generate
